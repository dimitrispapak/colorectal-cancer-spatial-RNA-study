# .gitignore file content

# Ignore everything by default
*
!notebooks/
!scripts/
# But don't ignore these file types
!*.py
!*.R
!*.r
!*.sh
!*.ipynb
!*.md

# Don't ignore the .gitignore file itself
!.gitignore

# Optional: Ignore specific files that might match the patterns above
# For example, you might want to ignore compiled Python files
*.py[cod]
__pycache__/
